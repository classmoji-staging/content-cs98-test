      "children": []
    },
    {
      "id": "b8ddba0ad0c",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "🚀 We’ll be choosing a landing page website to flatter. And by flatter, I mean rip-off. But by rip-off, I mean reconstruct a clean version using our own content. You’ll be looking at some webpages, and then inspecting them and seeing how much of the look and feel you can copy onto your own page.",
          "styles": {}
        }
      ],
      "children": []
    },
