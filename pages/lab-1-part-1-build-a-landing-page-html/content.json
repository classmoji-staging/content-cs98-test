      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "🚀 Please use the repository created for you in Classm🍎ji. There's a GitHub repo waiting for you under the CS52 class GitHub organization, and it's what gives course staff access to your work. Please use the provided repo for this assignment — do not use a personal repo!",
          "styles": {}
        }
