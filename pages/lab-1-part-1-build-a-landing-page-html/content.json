      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "A landing page, you say? Yes, you will be making a landing page based on a real page out there in the world. You will be mimicking the structure and style of a page but with your own content.",
          "styles": {}
