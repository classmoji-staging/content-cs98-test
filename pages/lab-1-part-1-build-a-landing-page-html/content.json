        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "You can also browse for inspiration here: landingfolio.com. You can also choose multiple pages to pick and choose things from.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "bcbc313a480",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
        "textColor": "default",
        "textAlignment": "left"
      },
      "content": [
        {
          "type": "text",
          "text": "Please be creative with your content! You can and should make your own content on this page. Do not copy my content, or the websites content, make up your own.",
          "styles": {}
        }
      ],
      "children": []
    },
    {
      "id": "b9e8b4bd340",
      "type": "paragraph",
      "props": {
        "backgroundColor": "default",
